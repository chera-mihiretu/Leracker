# Supabase Configuration
# Obtain your project URL and public Anon Key from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sign-In OAuth Configuration
# Web Client ID (needed for serverClientId to exchange idToken on Android & Web)
GOOGLE_WEB_CLIENT_ID=
# iOS Client ID (if running on iOS)
GOOGLE_IOS_CLIENT_ID=
